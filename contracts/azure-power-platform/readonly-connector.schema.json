      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],
      "properties": {
        "description": { "const": "Caller authority, tenant, expiry, revocation, policy or binding denial. The error body carries a fixed public reason code and no free-text internals." },
        "schema": { "const": { "$ref": "#/definitions/ConnectorError" } }
      }
    },
    "response404": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],

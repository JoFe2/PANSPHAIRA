              "correlationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "idempotencyKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "QueryAccepted": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "operationKey", "operationId", "status", "correlationDigest", "idempotencyKeyDigest", "businessSuccess", "verificationTuple"],
            "properties": {
              "schemaVersion": { "const": "pansphaira.power-platform/readonly-connector/v1" },
              "operationKey": { "const": "SUBMIT_GOVERNED_QUERY" },
              "operationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "status": { "const": "ACCEPTED" },
              "correlationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "idempotencyKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "businessSuccess": { "const": false },
              "verificationTuple": { "$ref": "#/definitions/VerificationTuple" }
            }
          }
        },
        "Capability": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationKey", "operationId", "method", "path", "semantic", "delegatedScope", "idempotencyKeyRequired", "callerActions"],
            "properties": {
              "operationKey": { "type": "string" },
              "operationId": { "type": "string" },
              "method": { "type": "string" },
              "path": { "type": "string" },
              "semantic": { "type": "string" },
              "delegatedScope": { "type": "string" },
              "idempotencyKeyRequired": { "type": "boolean" },
              "callerActions": { "type": "array", "items": { "type": "string" } }
            },
            "enum": [
              { "operationKey": "LIST_CAPABILITIES", "operationId": "ListCapabilities", "method": "GET", "path": "/v1/capabilities", "semantic": "DISCOVERY", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD", "READ_METADATA"] },
              { "operationKey": "SUBMIT_GOVERNED_QUERY", "operationId": "SubmitGovernedQuery", "method": "POST", "path": "/v1/queries", "semantic": "LOGICAL_READ", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": true, "callerActions": ["READ_RECORD", "READ_METADATA"] },
              { "operationKey": "GET_OPERATION_STATUS", "operationId": "GetOperationStatus", "method": "GET", "path": "/v1/operations/{operationId}", "semantic": "STATUS", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD"] },
              { "operationKey": "GET_READBACK", "operationId": "GetReadback", "method": "GET", "path": "/v1/operations/{operationId}/readback", "semantic": "AUTHORITATIVE_READBACK", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD"] },
              { "operationKey": "GET_RECEIPT", "operationId": "GetReceipt", "method": "GET", "path": "/v1/operations/{operationId}/receipt", "semantic": "BOUND_RECEIPT", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD"] }
            ]
          }
        },
        "ListCapabilitiesResponse": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "operationKey", "environmentClass", "capabilities", "callerActionAllowlist", "governedMutationActionAllowlist", "verificationTuple"],
            "properties": {
              "schemaVersion": { "const": "pansphaira.power-platform/readonly-connector/v1" },
              "operationKey": { "const": "LIST_CAPABILITIES" },
              "environmentClass": { "const": "LOCAL_SYNTHETIC_REPOSITORY_ONLY" },
              "capabilities": { "const": [
                { "operationKey": "LIST_CAPABILITIES", "operationId": "ListCapabilities", "method": "GET", "path": "/v1/capabilities", "semantic": "DISCOVERY", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD", "READ_METADATA"] },
                { "operationKey": "SUBMIT_GOVERNED_QUERY", "operationId": "SubmitGovernedQuery", "method": "POST", "path": "/v1/queries", "semantic": "LOGICAL_READ", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": true, "callerActions": ["READ_RECORD", "READ_METADATA"] },
                { "operationKey": "GET_OPERATION_STATUS", "operationId": "GetOperationStatus", "method": "GET", "path": "/v1/operations/{operationId}", "semantic": "STATUS", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD"] },
                { "operationKey": "GET_READBACK", "operationId": "GetReadback", "method": "GET", "path": "/v1/operations/{operationId}/readback", "semantic": "AUTHORITATIVE_READBACK", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD"] },
                { "operationKey": "GET_RECEIPT", "operationId": "GetReceipt", "method": "GET", "path": "/v1/operations/{operationId}/receipt", "semantic": "BOUND_RECEIPT", "delegatedScope": "cm.discovery.read", "idempotencyKeyRequired": false, "callerActions": ["READ_RECORD"] }
              ] },
              "callerActionAllowlist": { "const": ["READ_RECORD", "READ_METADATA"] },
              "governedMutationActionAllowlist": { "const": [] },
              "verificationTuple": { "$ref": "#/definitions/VerificationTuple" }
            }
          }
        },
        "OperationStatusResponse": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "operationKey", "operationId", "status", "reasonCodes", "businessSuccess", "verificationTuple"],
            "properties": {
              "schemaVersion": { "const": "pansphaira.power-platform/readonly-connector/v1" },
              "operationKey": { "const": "GET_OPERATION_STATUS" },
              "operationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "status": { "enum": ["ACCEPTED", "REJECTED", "REPLAY_CONSUMED", "AMBIGUOUS_CONSUMED", "RECEIPTED"] },
              "reasonCodes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/definitions/ReasonCode" } },
              "businessSuccess": { "type": "boolean" },
              "verificationTuple": { "$ref": "#/definitions/VerificationTuple" }
            }
          }
        },
        "AuthoritativeReadbackResponse": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "operationKey", "operationId", "source", "requestDigest", "correlationDigest", "effectCount", "outcome", "verificationTuple"],
            "properties": {
              "schemaVersion": { "const": "pansphaira.power-platform/readonly-connector/v1" },
              "operationKey": { "const": "GET_READBACK" },
              "operationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "source": { "const": "PROVIDER_OR_TENANT_CONTROL_PLANE_READ_AFTER_EFFECT_NOT_REQUEST_ECHO" },
              "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "correlationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "effectCount": { "const": 0 },
              "outcome": { "const": "SUCCESS" },
              "verificationTuple": { "$ref": "#/definitions/VerificationTuple" }

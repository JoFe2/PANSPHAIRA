              "correlationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "decisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "securityDefinitions": {
      "const": {
        "powerPlatformReadOnlyOAuth2": {
          "description": "Delegated read-only OAuth against the pinned synthetic host. Authentication grants no authority beyond the pinned scope.",
          "type": "oauth2",
          "flow": "accessCode",
          "authorizationUrl": "https://pansphaira-power-platform-read-only.synthetic.invalid/v1/auth/authorize",
          "scopes": {
            "cm.discovery.read": "Capability discovery and governed read-only queries."
          }
        }
      }
    },
    "x-pansphaira-connector": { "$ref": "#/$defs/xConnector" }
  },
  "$defs": {
    "securedOperationBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "tags", "parameters", "security", "responses"]
    },
    "listCapabilitiesOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "description", "tags", "parameters", "security", "responses"],
      "properties": {
        "operationId": { "const": "ListCapabilities" },
        "description": { "const": "List the exact five declared read-only operations and their pinned scope and idempotency requirements." },
        "tags": { "const": ["read-only"] },
        "parameters": { "const": [] },
        "security": { "const": [{ "powerPlatformReadOnlyOAuth2": ["cm.discovery.read"] }] },
        "responses": { "$ref": "#/$defs/responses200_400_403" }
      }
    },
    "queriesOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "description", "tags", "parameters", "security", "responses"],
      "properties": {
        "operationId": { "const": "SubmitGovernedQuery" },
        "description": { "const": "Submit a previously stored immutable Gateway read request referenced by digest only. Acceptance is an operation reference, never business success." },
        "tags": { "const": ["read-only"] },
        "parameters": {
          "const": [
            {
              "name": "governedQuery",
              "in": "body",
              "required": true,
              "description": "A previously stored immutable Gateway read request referenced by digest only.",
              "schema": { "$ref": "#/definitions/SubmitGovernedQueryRequest" }
            }
          ]
        },
        "security": { "const": [{ "powerPlatformReadOnlyOAuth2": ["cm.discovery.read"] }] },
        "responses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["202", "400", "403"],
          "properties": {
            "202": { "$ref": "#/$defs/response202" },
            "400": { "$ref": "#/$defs/response400" },
            "403": { "$ref": "#/$defs/response403" }
          }
        }
      }
    },
    "operationStatusOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "description", "tags", "parameters", "security", "responses"],
      "properties": {
        "operationId": { "const": "GetOperationStatus" },
        "description": { "const": "Read the status of the referenced accepted operation." },
        "tags": { "const": ["read-only"] },
        "parameters": { "$ref": "#/$defs/operationIdParameter" },
        "security": { "const": [{ "powerPlatformReadOnlyOAuth2": ["cm.discovery.read"] }] },
        "responses": { "$ref": "#/$defs/operationStatusResponses" }
      }
    },
    "readbackOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "description", "tags", "parameters", "security", "responses"],
      "properties": {
        "operationId": { "const": "GetReadback" },
        "description": { "const": "Read the authoritative post-effect readback for the referenced accepted operation." },
        "tags": { "const": ["read-only"] },
        "parameters": { "$ref": "#/$defs/operationIdParameter" },
        "security": { "const": [{ "powerPlatformReadOnlyOAuth2": ["cm.discovery.read"] }] },
        "responses": { "$ref": "#/$defs/readbackResponses" }
      }
    },
    "receiptOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "description", "tags", "parameters", "security", "responses"],
      "properties": {
        "operationId": { "const": "GetReceipt" },
        "description": { "const": "Read the bound receipt for the referenced accepted operation." },
        "tags": { "const": ["read-only"] },
        "parameters": { "$ref": "#/$defs/operationIdParameter" },
        "security": { "const": [{ "powerPlatformReadOnlyOAuth2": ["cm.discovery.read"] }] },
        "responses": { "$ref": "#/$defs/receiptResponses" }
      }
    },
    "listCapabilitiesPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["get"],
      "properties": { "get": { "$ref": "#/$defs/listCapabilitiesOperation" } }
    },
    "queriesPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post"],
      "properties": { "post": { "$ref": "#/$defs/queriesOperation" } }
    },
    "operationStatusPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["get"],
      "properties": { "get": { "$ref": "#/$defs/operationStatusOperation" } }
    },
    "readbackPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["get"],
      "properties": { "get": { "$ref": "#/$defs/readbackOperation" } }
    },
    "receiptPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["get"],
      "properties": { "get": { "$ref": "#/$defs/receiptOperation" } }
    },
    "operationIdParameter": {
      "const": [
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "description": "The digest of the accepted operation reference.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "listCapabilitiesResponse200": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],
      "properties": {
        "description": { "const": "The five declared read-only capabilities and their pinned scope and idempotency requirements." },
        "schema": { "const": { "$ref": "#/definitions/ListCapabilitiesResponse" } }
      }
    },
    "operationStatusResponse200": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],
      "properties": {
        "description": { "const": "The current status of the referenced accepted operation; acceptance is not business success." },
        "schema": { "const": { "$ref": "#/definitions/OperationStatusResponse" } }
      }
    },
    "readbackResponse200": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],
      "properties": {
        "description": { "const": "The authoritative post-effect readback for the referenced accepted operation." },
        "schema": { "const": { "$ref": "#/definitions/AuthoritativeReadbackResponse" } }
      }
    },
    "receiptResponse200": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],
      "properties": {
        "description": { "const": "The bound receipt for the referenced accepted operation." },
        "schema": { "const": { "$ref": "#/definitions/BoundReceiptResponse" } }
      }
    },
    "response202": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "schema"],
      "properties": {
        "description": { "const": "Governed read reference accepted as an operation reference only; not business success." },
        "schema": { "const": { "$ref": "#/definitions/QueryAccepted" } }
      }

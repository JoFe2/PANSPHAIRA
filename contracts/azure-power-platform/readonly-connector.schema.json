      ],
      "properties": {
        "VerificationTuple": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bundleSchemaVersion", "subjectDigest", "planDigest", "evidenceBundleDigest", "verdictDigest", "readbackDigest"],

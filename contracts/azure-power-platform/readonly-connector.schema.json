        "BoundReceiptResponse": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "operationKey",
              "operationId",
              "requestDigest",
              "correlationDigest",
              "idempotencyKeyDigest",
              "policyGeneration",
              "policyGenerationReason",
              "catalogueSchemaVersion",
              "catalogueId",
              "catalogueVersion",
              "catalogueDigest",
              "policySchemaVersion",
              "policyId",
              "policyVersion",
              "policyDigest",
              "gatewayDecisionSchemaVersion",
              "brokerReceiptSchemaVersion",
              "brokerReceiptRequiredBindingFields",
              "powerPlatformActionCompatibility",
              "powerPlatformMayInvokeCurrentActions",
              "fullTupleDigest",
              "effectCount",
              "outcome",
              "receiptDigest",
              "verificationTuple"
            ],
            "properties": {
              "schemaVersion": { "const": "pansphaira.power-platform/readonly-connector/v1" },
              "operationKey": { "const": "GET_RECEIPT" },
              "operationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "correlationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "idempotencyKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "policyGeneration": { "type": "null" },
              "policyGenerationReason": { "const": "The capability policy v1 export is version-and-digest bound and does not export a numeric policyGeneration." },
              "catalogueSchemaVersion": { "const": "chimpmaera.security/capability-catalogue/v1" },
              "catalogueId": { "const": "chimpmaera.local/synthetic-actions" },
              "catalogueVersion": { "const": "1.0.0" },
              "catalogueDigest": { "const": "bb0060a254f450684bd17f6559d267d6f02d225c4c4d37479c3010c60d1b8427" },
              "policySchemaVersion": { "const": "chimpmaera.security/capability-policy-binding/v1" },
              "policyId": { "const": "policy:synthetic-safe-guided" },
              "policyVersion": { "const": "1.0.0" },
              "policyDigest": { "const": "c0670df5ef0d91635316b52f66cc65123792b857c328d24e21daf98a0adf2b89" },
              "gatewayDecisionSchemaVersion": { "const": "chimpmaera.security/capability-gateway-decision/v1" },
              "brokerReceiptSchemaVersion": { "const": "chimpmaera.security/capability-broker-receipt/v1" },
              "brokerReceiptRequiredBindingFields": {
                "const": [
                  "schemaVersion",
                  "environmentClass",
                  "fullTupleDigest",
                  "catalogueVersion",
                  "catalogueDigest",
                  "actionId",
                  "actionVersion",
                  "actionDigest",
                  "requestDigest",
                  "proposalDigest",
                  "decisionDigest",
                  "policyGeneration",
                  "policyDigest",
                  "authorityLeaseDigest",
                  "authorityExpiresAtDigest",
                  "revocationObservationDigest",
                  "replayKeyDigest",
                  "providerObjectReferenceDigest",
                  "readbackDigest",
                  "effectCount",
                  "outcome",
                  "receiptDigest"
                ]
              },
              "powerPlatformActionCompatibility": { "const": "INCOMPATIBLE_NO_POWER_PLATFORM_ACTION" },
              "powerPlatformMayInvokeCurrentActions": { "const": false },
              "fullTupleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "effectCount": { "const": 0 },
              "outcome": { "const": "BOUND" },
              "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "verificationTuple": { "$ref": "#/definitions/VerificationTuple" }

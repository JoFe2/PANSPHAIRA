{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/azure-power-platform/readonly-connector.openapi.yaml.schema.json",
  "title": "PanSphaira Power Platform read-only connector OpenAPI v1 closed surface",
  "description": "Validates the single closed read-only connector OpenAPI document at contracts/azure-power-platform/readonly-connector.openapi.yaml. Every object schema node has additionalProperties false and every field is explicitly required. Responses use only explicit status codes and schema refs with no default response. The frozen values are bound verbatim from the Sol reconciliation receipt and the reusable ChimpMaera Gateway contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "swagger",
    "info",
    "host",
    "schemes",
    "basePath",
    "consumes",
    "produces",
    "paths",
    "definitions",
    "securityDefinitions",
    "x-pansphaira-connector"
  ],
  "properties": {
    "swagger": { "const": "2.0" },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "description"],
      "properties": {
        "title": { "const": "PanSphaira Power Platform read-only connector (closed surface v1)" },
        "version": { "const": "1.0.0" },
        "description": { "const": "Closed read-only Power Platform connector surface for capability discovery, governed queries, operation status, authoritative readback and bound receipts. Local synthetic repository-only evidence; no provider call, credential use or tenant access." }
      }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.invalid/contracts/rks-01/source-profile-v1.schema.json",
  "title": "RKS-01 closed source profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "sourceClass", "canonicalUrl", "immutableIdentity", "mediaType", "parser", "canonicalizer", "legal", "boundary", "profileDigest"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.rks01/source-profile/v1" },
    "profileId": { "$ref": "#/$defs/id" },
    "sourceClass": { "enum": ["STRUCTURED_GENERAL_KNOWLEDGE", "VERSIONED_TECHNICAL_DOCUMENTATION", "NORMATIVE_OPEN_SPECIFICATION", "NORMATIVE_ARCHIVAL_CONTROL"] },
    "canonicalUrl": { "$ref": "#/$defs/officialUrl" },
    "immutableIdentity": { "$ref": "#/$defs/identity" },
    "mediaType": { "$ref": "#/$defs/mediaType" },
    "parser": { "$ref": "#/$defs/tool" },
    "canonicalizer": { "$ref": "#/$defs/tool" },
    "legal": { "$ref": "#/$defs/legal" },
    "boundary": { "const": { "truthGrant": "NONE", "capabilityGrant": "NONE", "authorityGrant": "NONE", "legalAdvice": false } },
    "profileDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{3,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 512 },
    "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["kind", "version", "revision"], "properties": { "kind": { "enum": ["REVISION", "COMMIT", "VERSION", "VERSION_AND_COMMIT"] }, "version": { "type": "string", "minLength": 1, "maxLength": 128 }, "revision": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{4,128}$" } } },
    "stringList": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "legal": { "type": "object", "additionalProperties": false, "required": ["licenseDecision", "licenseId", "transformationClass", "notice", "attribution", "obligations"], "properties": { "licenseDecision": { "const": "KNOWN" }, "licenseId": { "type": "string", "pattern": "^[A-Za-z0-9.-]{3,128}$" }, "transformationClass": { "enum": ["TRANSFORM_ALLOWED", "UNMODIFIED_ONLY"] }, "notice": { "type": "string", "minLength": 1, "maxLength": 512 }, "attribution": { "$ref": "#/$defs/stringList" }, "obligations": { "$ref": "#/$defs/stringList" } } }
  }
}

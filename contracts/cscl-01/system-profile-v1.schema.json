{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.invalid/contracts/cscl-01/system-profile-v1.schema.json",
  "title": "CSCL-01 non-authoritative system profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "systemId", "systemRole", "selectorSetDigest", "questionInventoryDigest", "sourceFactDigests", "sourceNativeTerminology", "capabilityFamilies", "evidenceCells", "holdoutIsolation", "boundary", "profileDigest"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.cscl01/system-profile/v1" },
    "profileId": { "$ref": "#/$defs/id" },
    "systemId": { "enum": ["odoo-community", "erpnext", "dolibarr", "tryton", "apache-ofbiz", "idempiere"] },
    "systemRole": { "enum": ["TRAINING", "HOLDOUT"] },
    "selectorSetDigest": { "$ref": "#/$defs/digest" },
    "questionInventoryDigest": { "$ref": "#/$defs/digest" },
    "sourceFactDigests": { "$ref": "#/$defs/digests" },
    "sourceNativeTerminology": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["term", "meaning", "sourceFactDigest"], "properties": { "term": { "type": "string", "minLength": 1, "maxLength": 256 }, "meaning": { "type": "string", "minLength": 1, "maxLength": 2048 }, "sourceFactDigest": { "$ref": "#/$defs/digest" } } } },
    "capabilityFamilies": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/family" } },
    "evidenceCells": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["capabilityFamily", "questionId", "cellDigest"], "properties": { "capabilityFamily": { "$ref": "#/$defs/family" }, "questionId": { "$ref": "#/$defs/id" }, "cellDigest": { "$ref": "#/$defs/digest" } } } },
    "holdoutIsolation": { "enum": ["TRAINING_PROFILE", "HOLDOUT_PROFILE_AFTER_CANDIDATE_FREEZE"] },
    "boundary": { "$ref": "#/$defs/boundary" },
    "profileDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "if": { "properties": { "systemRole": { "const": "TRAINING" } }, "required": ["systemRole"] }, "then": { "properties": { "holdoutIsolation": { "const": "TRAINING_PROFILE" } } } },
    { "if": { "properties": { "systemRole": { "const": "HOLDOUT" } }, "required": ["systemRole"] }, "then": { "properties": { "holdoutIsolation": { "const": "HOLDOUT_PROFILE_AFTER_CANDIDATE_FREEZE" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{3,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "family": { "enum": ["PARTY_CUSTOMER_MANAGEMENT", "PRODUCT_ITEM_MANAGEMENT", "SALES_ORDER_MANAGEMENT"] },
    "boundary": { "const": { "authorityGrant": "NONE", "promotionGrant": "NONE", "executionGrant": "NONE" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.invalid/contracts/cscl-01/capability-candidate-v1.schema.json",
  "title": "CSCL-01 frozen capability candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "capabilityFamily", "status", "questionInventoryDigest", "decisionRuleDigest", "trainingProfileDigests", "coreConcepts", "variants", "absences", "ambiguities", "counterexamples", "processPatternCandidateDigests", "candidateBytesSha256", "boundary", "candidateDigest"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.cscl01/capability-candidate/v1" },
    "candidateId": { "$ref": "#/$defs/id" },
    "capabilityFamily": { "$ref": "#/$defs/family" },
    "status": { "const": "FROZEN_NON_AUTHORITATIVE_CANDIDATE" },
    "questionInventoryDigest": { "$ref": "#/$defs/digest" },
    "decisionRuleDigest": { "$ref": "#/$defs/digest" },
    "trainingProfileDigests": { "$ref": "#/$defs/fiveDigests" },
    "coreConcepts": { "$ref": "#/$defs/concepts" },
    "variants": { "$ref": "#/$defs/concepts" },
    "absences": { "$ref": "#/$defs/concepts" },
    "ambiguities": { "$ref": "#/$defs/concepts" },
    "counterexamples": { "$ref": "#/$defs/concepts" },
    "processPatternCandidateDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "candidateBytesSha256": { "$ref": "#/$defs/digest" },
    "boundary": { "$ref": "#/$defs/boundary" },
    "candidateDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{3,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "family": { "enum": ["PARTY_CUSTOMER_MANAGEMENT", "PRODUCT_ITEM_MANAGEMENT", "SALES_ORDER_MANAGEMENT"] },
    "fiveDigests": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "concept": { "type": "object", "additionalProperties": false, "required": ["conceptId", "meaning", "conceptDigest"], "properties": { "conceptId": { "$ref": "#/$defs/id" }, "meaning": { "type": "string", "minLength": 1, "maxLength": 4096 }, "conceptDigest": { "$ref": "#/$defs/digest" } } },
    "concepts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/concept" } },
    "boundary": { "const": { "authorityGrant": "NONE", "promotionGrant": "NONE", "executionGrant": "NONE" } }
  }
}

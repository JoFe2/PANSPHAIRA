{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/cks-synthetic-lineage-case-v1.schema.json",
  "title": "CKS-08 deterministic synthetic lineage cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopeClass", "semanticRuleId", "scopeRef", "knowledgeRefs", "thresholds", "tasks", "featureGroups", "negativeCases"],
  "properties": {
    "schemaVersion": { "const": "cks-08-synthetic-lineage-cases/v1" },
    "scopeClass": { "const": "LOCAL_SYNTHETIC_FIXTURE" },
    "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" },
    "scopeRef": { "$ref": "#/$defs/scopeRef" },
    "knowledgeRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["alpha", "beta", "gamma", "delta", "epsilon"],
      "properties": {
        "alpha": { "$ref": "#/$defs/knowledgeRef" }, "beta": { "$ref": "#/$defs/knowledgeRef" },
        "gamma": { "$ref": "#/$defs/knowledgeRef" }, "delta": { "$ref": "#/$defs/knowledgeRef" }, "epsilon": { "$ref": "#/$defs/knowledgeRef" }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["generalizationMinimumDistinctTaskSemantics", "generalizationMinimumDistinctContexts", "operationalMinimumDistinctOutcomeUnits"],
      "properties": {
        "generalizationMinimumDistinctTaskSemantics": { "const": 2 },
        "generalizationMinimumDistinctContexts": { "const": 2 },
        "operationalMinimumDistinctOutcomeUnits": { "const": 1 }
      }
    },
    "tasks": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/task" } },
    "featureGroups": {
      "type": "object", "additionalProperties": false, "required": ["repetition", "diverse"],
      "properties": { "repetition": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "diverse": { "type": "array", "minItems": 2, "items": { "type": "string" } } }
    },
    "negativeCases": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/negativeCase" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scopeRef": {
      "type": "object", "additionalProperties": false, "required": ["scopeId", "scopeDigest"],
      "properties": { "scopeId": { "type": "string", "pattern": "^scope:v1:[a-f0-9]{64}$" }, "scopeDigest": { "$ref": "#/$defs/digest" } }
    },
    "knowledgeRef": {
      "type": "object", "additionalProperties": false, "required": ["knowledgeId", "knowledgeDigest"],
      "properties": { "knowledgeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" }, "knowledgeDigest": { "$ref": "#/$defs/digest" } }
    },
    "witness": {
      "type": "object", "additionalProperties": false, "required": ["kind", "dimension"],
      "properties": {
        "kind": { "enum": ["KNOWLEDGE_PROFILE", "SEARCH_ORACLE", "DECISION_CHECK", "EXECUTION_RECEIPT", "TASK_INPUT_RECEIPT", "EXTERNAL_RECEIPT", "GOVERNANCE_RECEIPT", "UNKNOWN"] },
        "dimension": { "enum": ["SOURCE", "APPLICABILITY", "FRESHNESS", "CONTRADICTION", "GENERALIZATION", "NONE"] },
        "predicate": { "enum": ["UNSUPPORTED_SELECTION", "SUPPORTED_OPTION_IGNORED"] }
      }
    },
    "cause": {
      "type": "object", "additionalProperties": false, "required": ["class", "subtype", "certainty", "witness", "affectedKnowledge"],
      "properties": {
        "class": { "enum": ["KNOWLEDGE", "SEARCH", "DECISION", "EXECUTION", "TASK_INPUT", "EXTERNAL", "GOVERNANCE", "UNKNOWN"] },
        "subtype": { "type": "string", "minLength": 1 },
        "certainty": { "enum": ["CONFIRMED", "SUPPORTED", "POSSIBLE", "UNKNOWN"] },
        "witness": { "$ref": "#/$defs/witness" },
        "affectedKnowledge": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "taskKind", "taskSemantic", "context", "searchResults", "inspected", "used", "rejected", "decisionSupporting", "outcomeContributing", "outcomeClass", "causalMode", "causes", "profile"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "taskKind": { "enum": ["RETRIEVE", "DECIDE", "ACT", "VERIFY"] },
        "taskSemantic": { "type": "string", "minLength": 1 }, "context": { "type": "string", "minLength": 1 },
        "searchResults": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "inspected": { "type": "array", "items": { "type": "string" } }, "used": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "reasonCode"], "properties": { "id": { "type": "string" }, "reasonCode": { "enum": ["NOT_APPLICABLE", "STALE", "CONTRADICTED", "INSUFFICIENT_SOURCE_SUPPORT", "NOT_NEEDED", "POLICY_DENIED"] } } } },
        "decisionSupporting": { "type": "array", "items": { "type": "string" } }, "outcomeContributing": { "type": "array", "items": { "type": "string" } },
        "outcomeClass": { "enum": ["SUCCEEDED", "FAILED", "PARTIAL", "DENIED", "UNKNOWN"] },
        "causalMode": { "enum": ["NOT_APPLICABLE", "SINGLE", "MULTI_CONTRIBUTING", "MULTI_JOINT", "ALTERNATIVES_UNRESOLVED", "UNKNOWN"] },
        "causes": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/cause" } },
        "profile": { "enum": ["normal", "stale", "source-defect", "applicability-mismatch", "contradicted", "unsupported-generalization"] }
      }
    },
    "negativeCase": {
      "type": "object", "additionalProperties": false, "required": ["name", "sourceTask", "mutation", "expectedStatus"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }, "sourceTask": { "type": "string", "minLength": 1 },
        "mutation": { "enum": ["REMOVE_OUTCOME", "LATE_EVENT", "REPLAY_FIRST_EVENT", "CROSS_SCOPE", "TAMPER_FACT", "REMOVE_EVIDENCE", "CHANGE_WITNESS_DIMENSION", "CHANGE_CERTAINTY", "ADD_FOURTH_CAUSE"] },
        "expectedStatus": { "const": "DENIED" }
      }
    }
  }
}

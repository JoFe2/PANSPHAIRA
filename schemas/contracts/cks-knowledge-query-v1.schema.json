{
  "$id": "https://chimpmaera.dev/schemas/contracts/cks-knowledge-query-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChimpMaera CKS Knowledge Query binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "queryId", "object", "scopeNamespace", "requestedAtMs", "authority", "queryDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.cks/knowledge-query/v1" },
    "queryId": { "$ref": "#/$defs/id" },
    "object": { "$ref": "#/$defs/objectReference" },
    "scopeNamespace": { "$ref": "#/$defs/text" },
    "requestedAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "authority": { "$ref": "#/$defs/authority" },
    "queryDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\u0000-\\u001f]+$" },
    "objectReference": { "type": "object", "additionalProperties": false, "required": ["objectId", "objectDigest"], "properties": { "objectId": { "$ref": "#/$defs/id" }, "objectDigest": { "$ref": "#/$defs/digest" } } },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["credentials", "policyApprovals", "capabilities", "toolAccess", "writeTargets", "executionRoutes"],
      "properties": {
        "credentials": { "type": "array", "maxItems": 0 }, "policyApprovals": { "type": "array", "maxItems": 0 },
        "capabilities": { "type": "array", "maxItems": 0 }, "toolAccess": { "type": "array", "maxItems": 0 },
        "writeTargets": { "type": "array", "maxItems": 0 }, "executionRoutes": { "type": "array", "maxItems": 0 }
      }
    }
  }
}

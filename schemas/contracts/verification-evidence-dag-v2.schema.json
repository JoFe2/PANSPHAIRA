{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/verification-evidence-dag-v2.schema.json",
  "title": "ChimpMaera Verification Fabric Evidence DAG v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "graphVersion", "environment", "hardGates", "nodes"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.verification/evidence-dag/v2" },
    "graphId": { "$ref": "#/$defs/id" },
    "graphVersion": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "os", "architecture", "packageManager"],
      "properties": {
        "node": { "type": "string", "minLength": 1, "maxLength": 128 },
        "os": { "type": "string", "minLength": 1, "maxLength": 128 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 128 },
        "packageManager": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "hardGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256"],
      "properties": {
        "releaseId": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "role": {
          "enum": ["SOURCE", "CONTRACT", "SCHEMA", "FIXTURE", "VALIDATOR", "TOOLCHAIN", "ENVIRONMENT", "SECURITY", "DERIVED_EVIDENCE"]
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dependsOn", "inputs", "ownedTests", "invariants", "riskClass", "globalInvalidation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dependsOn": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/input" }
        },
        "ownedTests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "riskClass": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "globalInvalidation": { "type": "boolean" },
        "evidenceTtlMs": { "type": "integer", "minimum": 1 },
        "ttlJustification": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "dependentRequired": {
        "evidenceTtlMs": ["ttlJustification"],
        "ttlJustification": ["evidenceTtlMs"]
      }
    }
  }
}

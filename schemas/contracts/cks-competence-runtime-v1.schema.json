    "interactionPolicy": {"$ref": "#/$defs/interactionPolicy"},
    "resourceLimits": {"$ref": "#/$defs/resourceLimits"},
    "states": {"$ref": "#/$defs/states"},
    "contractDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "false": {"const": false},
    "true": {"const": true},
    "states": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {"enum": ["ANSWER_SUPPORTED", "NEED_MORE_KNOWLEDGE", "KNOWLEDGE_CONFLICT", "INSUFFICIENT_EVIDENCE", "COMPETENCE_LIMIT", "GOVERNED_ACTION_PROPOSAL"]}
    },
    "reasonCodes": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,

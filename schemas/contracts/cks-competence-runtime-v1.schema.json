      "properties": {"receiptPath": {"$ref": "#/$defs/text"}, "receiptDigest": {"$ref": "#/$defs/digest"}, "profileCoreDigest": {"$ref": "#/$defs/digest"}, "decisionId": {"$ref": "#/$defs/id"}}
    },
    "profile": {
      "type": "object", "additionalProperties": false,

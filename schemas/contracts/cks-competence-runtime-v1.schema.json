    },
    "prompt": {
      "type": "object", "additionalProperties": false, "required": ["promptId", "promptVersion", "encoding", "normalization", "trailingLineFeed", "assemblyVersion", "chatTemplateSource", "sha256"],
      "properties": {"promptId": {"$ref": "#/$defs/id"}, "promptVersion": {"$ref": "#/$defs/id"}, "encoding": {"const": "UTF-8"}, "normalization": {"const": "NONE"}, "trailingLineFeed": {"$ref": "#/$defs/false"}, "assemblyVersion": {"$ref": "#/$defs/id"}, "chatTemplateSource": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "toolProtocols": {"type": "object", "additionalProperties": false, "required": ["catalogueMode", "unknownToolsOrFields", "wireFormat", "queryTool", "evidencePackResult", "finalResponse"], "properties": {"catalogueMode": {"const": "CLOSED_EXACTLY_ONE_MODEL_CALLABLE_TOOL"}, "unknownToolsOrFields": {"const": "DENY"}, "wireFormat": {"$ref": "#/$defs/text"}, "queryTool": {"$ref": "#/$defs/queryTool"}, "evidencePackResult": {"$ref": "#/$defs/evidencePackProtocol"}, "finalResponse": {"$ref": "#/$defs/finalResponseProtocol"}}},

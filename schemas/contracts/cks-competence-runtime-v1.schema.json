{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan-sphaira.dev/schemas/contracts/cks-competence-runtime-v1.schema.json",
  "title": "PanSphaira CKS competence runtime contract v1",
  "description": "Closed data-only runtime contract. It binds the selected model profile and the six competence states; the only model-callable retrieval protocol is the bounded Knowledge Query.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "receiptSource", "profile", "model", "quantization", "runtime", "context", "decoding", "prompt", "toolProtocols", "knowledgeBindings", "interactionPolicy", "resourceLimits", "states", "contractDigest"],
  "properties": {
    "schemaVersion": {"const": "pansphaira.cks/competence-runtime/v1"},
    "contractId": {"const": "cks-competence-runtime-contract:psai284-v1"},
    "receiptSource": {"$ref": "#/$defs/receiptSource"},
    "profile": {"$ref": "#/$defs/profile"},
    "model": {"$ref": "#/$defs/model"},
    "quantization": {"$ref": "#/$defs/quantization"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "context": {"$ref": "#/$defs/context"},
    "decoding": {"$ref": "#/$defs/decoding"},
    "prompt": {"$ref": "#/$defs/prompt"},
    "toolProtocols": {"$ref": "#/$defs/toolProtocols"},

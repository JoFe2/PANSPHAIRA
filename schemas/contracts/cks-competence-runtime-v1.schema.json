    },
    "statuses": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["MATCH", "NEEDS_CONTEXT", "CONFLICT", "NO_MATCH", "DENIED"]}

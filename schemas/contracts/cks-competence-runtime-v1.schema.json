      "properties": {"profileSchemaVersion": {"$ref": "#/$defs/id"}, "profileId": {"$ref": "#/$defs/id"}, "profileRevision": {"type": "integer", "minimum": 1, "maximum": 1024}, "intendedUse": {"$ref": "#/$defs/id"}, "selectionStatus": {"const": "SELECTED_NOT_QUALIFIED"}}
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["publisher", "name", "baseModelId", "artifactRepository", "artifactRevision", "artifactFile", "artifactFormat", "artifactArchitecture", "artifactSha256", "artifactSizeBytes", "artifactSourceUrl", "mutableAliasesForbidden", "localArtifactVerificationRequired", "artifactAcquiredByThisDecision"],
      "properties": {
        "publisher": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/id"}, "baseModelId": {"$ref": "#/$defs/id"}, "artifactRepository": {"$ref": "#/$defs/id"}, "artifactRevision": {"$ref": "#/$defs/id"}, "artifactFile": {"$ref": "#/$defs/id"}, "artifactFormat": {"$ref": "#/$defs/id"}, "artifactArchitecture": {"$ref": "#/$defs/id"}, "artifactSha256": {"$ref": "#/$defs/digest"}, "artifactSizeBytes": {"$ref": "#/$defs/positiveInteger"}, "artifactSourceUrl": {"type": "string", "minLength": 1, "maxLength": 512}, "mutableAliasesForbidden": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "localArtifactVerificationRequired": {"$ref": "#/$defs/true"}, "artifactAcquiredByThisDecision": {"$ref": "#/$defs/false"}
      }
    },
    "quantization": {
      "type": "object", "additionalProperties": false, "required": ["scheme", "source", "conversionOrRequantizationAllowed", "quantizationEquivalenceClaimed", "reproducibleConversionClaimed"],
      "properties": {"scheme": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "conversionOrRequantizationAllowed": {"$ref": "#/$defs/false"}, "quantizationEquivalenceClaimed": {"$ref": "#/$defs/false"}, "reproducibleConversionClaimed": {"$ref": "#/$defs/false"}}
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "releaseTag", "sourceCommit", "executable", "distributionAsset", "distributionAssetUrl", "distributionAssetSha256", "distributionAssetSizeBytes", "backend", "gpuLayers", "parallelSequences", "threads", "batchSize", "microBatchSize", "memoryMap", "memoryLock", "embeddedChatTemplateRequired", "chatTemplateOverrideAllowed", "runtimeArchiveAcquiredByThisDecision", "runManifestMustBindExtractedExecutableSha256", "runManifestMustCaptureVersionReadback"],
      "properties": {"implementation": {"$ref": "#/$defs/id"}, "releaseTag": {"$ref": "#/$defs/id"}, "sourceCommit": {"$ref": "#/$defs/id"}, "executable": {"$ref": "#/$defs/id"}, "distributionAsset": {"$ref": "#/$defs/id"}, "distributionAssetUrl": {"type": "string", "minLength": 1, "maxLength": 512}, "distributionAssetSha256": {"$ref": "#/$defs/digest"}, "distributionAssetSizeBytes": {"$ref": "#/$defs/positiveInteger"}, "backend": {"$ref": "#/$defs/id"}, "gpuLayers": {"type": "integer", "minimum": 0, "maximum": 0}, "parallelSequences": {"const": 1}, "threads": {"type": "integer", "minimum": 1, "maximum": 64}, "batchSize": {"type": "integer", "minimum": 1, "maximum": 1048576}, "microBatchSize": {"type": "integer", "minimum": 1, "maximum": 1048576}, "memoryMap": {"type": "boolean"}, "memoryLock": {"type": "boolean"}, "embeddedChatTemplateRequired": {"$ref": "#/$defs/true"}, "chatTemplateOverrideAllowed": {"$ref": "#/$defs/false"}, "runtimeArchiveAcquiredByThisDecision": {"$ref": "#/$defs/false"}, "runManifestMustBindExtractedExecutableSha256": {"$ref": "#/$defs/true"}, "runManifestMustCaptureVersionReadback": {"$ref": "#/$defs/true"}}

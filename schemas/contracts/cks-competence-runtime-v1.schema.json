        "requestId": {"$ref": "#/$defs/argumentDescription"},
        "taskId": {"$ref": "#/$defs/argumentDescription"},
        "knowledgeEditionId": {"$ref": "#/$defs/argumentDescription"},
        "knowledgeEditionVersion": {"$ref": "#/$defs/argumentDescription"},

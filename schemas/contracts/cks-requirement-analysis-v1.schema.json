{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/PANSPHAIRA/schemas/contracts/cks-requirement-analysis-v1.schema.json",
  "title": "PANSPHAIRA CKS deterministic forward requirement analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "caseId", "fixtureDigest", "semanticRuleSetDigest", "requirementSetDigest", "candidateSetDigest", "requirements", "p11", "outcome", "blockedReasons", "analysisDigest"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.cks/forward-requirement-analysis/v1" },
    "analysisId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "fixtureDigest": { "$ref": "#/$defs/digest" },
    "semanticRuleSetDigest": { "$ref": "#/$defs/digest" },
    "requirementSetDigest": { "$ref": "#/$defs/digest" },
    "candidateSetDigest": { "$ref": "#/$defs/digest" },
    "requirements": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/result" } },
    "p11": { "$ref": "#/$defs/p11" },
    "outcome": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "blockedReasons": { "type": "array", "uniqueItems": true, "maxItems": 7, "items": { "$ref": "#/$defs/blockedReason" } },
    "analysisDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "BLOCKED" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "blockedReasons": { "type": "array", "minItems": 1 },
          "requirements": { "type": "array", "maxItems": 0 },
          "p11": { "$ref": "#/$defs/p11Blocked" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["PASS", "FAIL"] } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "blockedReasons": { "type": "array", "maxItems": 0 },
          "requirements": { "type": "array", "minItems": 1 },
          "p11": { "$ref": "#/$defs/p11Measured" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "blockedReason": { "enum": ["DEPENDENCY_EVIDENCE_ABSENT", "DEPENDENCY_SCHEMA_INVALID", "DEPENDENCY_DIGEST_MISMATCH", "REQUIRED_SEMANTIC_RULE_ABSENT", "UNKNOWN_VOCABULARY_VALUE", "REQUIRED_APPLICABILITY_RULE_ABSENT", "DENOMINATOR_EVIDENCE_ABSENT"] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "criticality", "applicability", "state", "matchedCandidateId"],
      "properties": {
        "requirementId": { "$ref": "#/$defs/id" },
        "criticality": { "enum": ["CRITICAL", "NON_CRITICAL"] },
        "applicability": { "enum": ["APPLICABLE", "NOT_APPLICABLE"] },
        "state": { "enum": ["SATISFIED", "NOT_APPLICABLE", "MISSING", "BAD_SOURCE", "APPLICABILITY", "CONFLICTING", "UNKNOWN_SEMANTIC", "CRITICALITY_MISMATCH"] },
        "matchedCandidateId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
      }
    },
    "p11Blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "blockedReasons"],
      "properties": {
        "schemaVersion": { "const": "pansphaira.cks/p11-requirement-measurement/v1" },
        "status": { "const": "BLOCKED" },
        "blockedReasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/blockedReason" } }
      }
    },
    "p11Measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "R", "P", "M", "C", "CM", "CX", "requirementRecall", "requirementPrecision", "criticalRequirementMissRate", "criticalRequirementMisses", "criticalityMismatches"],
      "properties": {
        "schemaVersion": { "const": "pansphaira.cks/p11-requirement-measurement/v1" },
        "status": { "enum": ["PASS", "FAIL"] },
        "R": { "type": "integer", "minimum": 1 },
        "P": { "type": "integer", "minimum": 0 },
        "M": { "type": "integer", "minimum": 0 },
        "C": { "type": "integer", "minimum": 1 },
        "CM": { "type": "integer", "minimum": 0 },
        "CX": { "type": "integer", "minimum": 0 },
        "requirementRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "requirementPrecision": { "type": "number", "minimum": 0, "maximum": 1 },
        "criticalRequirementMissRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "criticalRequirementMisses": { "type": "integer", "minimum": 0 },
        "criticalityMismatches": { "type": "integer", "minimum": 0 }
      }
    },
    "p11": {
      "oneOf": [{ "$ref": "#/$defs/p11Blocked" }, { "$ref": "#/$defs/p11Measured" }]
    }
  }
}

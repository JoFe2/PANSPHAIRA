{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pansphaira.cks/knowledge-bundle/v1",
  "title": "CKS-09 KnowledgeBundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleId", "contentRefs", "scopeIds", "versionVector", "provenanceRefs", "canonicalDigest"],
  "properties": {
    "bundleId": {"$ref": "#/$defs/id"},
    "contentRefs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/contentRef"}},
    "scopeIds": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "versionVector": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/version"}},
    "provenanceRefs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "canonicalDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["contentId", "contentDigest", "provenanceRef"],
      "properties": {"contentId": {"$ref": "#/$defs/id"}, "contentDigest": {"$ref": "#/$defs/digest"}, "provenanceRef": {"$ref": "#/$defs/id"}}
    },
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "versionScheme", "exactValue"],
      "properties": {
        "componentId": {"$ref": "#/$defs/id"},
        "versionScheme": {"enum": ["SEMVER_EXACT", "OPAQUE_EXACT", "SHA256_EXACT"]},
        "exactValue": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      }
    }
  }
}

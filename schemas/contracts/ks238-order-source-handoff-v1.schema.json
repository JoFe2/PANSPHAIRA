{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.local/schemas/contracts/ks238-order-source-handoff-v1.schema.json",
  "title": "KS238 PAN order/source handoff binding",
  "description": "Read-only, content-bound order/source handoff to the KS238 sales analysis. It exposes only evidenced order/customer/status/period facts and explicit unsupported/missing semantics. Per-order quantity and unit are UNAVAILABLE for this reader (the selected source and the released reader expose no quantity or unit); a unitless reader result never becomes a per-order EACH fact. It is not a revenue, delivery, historical order-book or order-management authority, and it never infers net revenue from order status or ordered quantity. The explicit unsupported/missing contract is embedded and digest-bound so it survives serialization and is returned on rebind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "consumerContract", "trust", "supportedFacts", "contentBinding", "supported", "unsupportedFacts"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.ks238/order-source-handoff/v1" },
    "consumerContract": { "const": "ks238.sales-analysis.order-source/v1" },
    "trust": { "const": "LOCAL_SYNTHETIC" },
    "supportedFacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["orderIdentity", "customerIdentity", "orderStatus", "orderPeriod"] }
    },
    "contentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "sourceDigest", "sourceBytesSha256", "readbackDigest", "customerSourceDigest"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceBytesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "readbackDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "customerSourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderFacts", "statusCounts"],
      "properties": {
        "orderFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "customerStatus"],
            "properties": {
              "order": {
                "type": "object",
                "additionalProperties": false,
                "required": ["orderId", "customerId", "orderStatus", "period", "quantityUnit"],
                "properties": {
                  "orderId": { "type": "string", "minLength": 1 },
                  "customerId": { "type": "string", "minLength": 1 },
                  "orderStatus": { "enum": ["OPEN", "FULFILLED", "CANCELLED"] },
                  "period": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["granularity", "month", "orderDate"],
                    "properties": {
                      "granularity": { "const": "CALENDAR_MONTH" },
                      "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                      "orderDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                    }
                  },
                  "quantityUnit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["quantity", "unit"],
                    "properties": {
                      "quantity": { "const": "UNAVAILABLE" },
                      "unit": { "const": "UNAVAILABLE" }
                    }
                  }
                }
              },
              "customerStatus": { "enum": ["ACTIVE", "ON_HOLD", "UNAVAILABLE"] }
            }
          }
        },
        "statusCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 },
          "propertyNames": { "enum": ["OPEN", "FULFILLED", "CANCELLED"] }
        }
      }
    },
    "unsupportedFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "facts", "missingFields", "nonClaims"],
      "properties": {
        "code": { "const": "REVENUE_AND_HISTORY_UNAVAILABLE" },
        "facts": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "enum": ["netRevenue", "orderedQuantity", "quantityUnit", "amount", "currencyValue", "deliveryFacts", "historicalOrderBook", "orderIntake", "creditsCancellationsNetting"] }
        },
        "missingFields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["amount.currencyValue", "amount.netRevenue", "quantity.orderedQuantity", "quantity.unit", "delivery.deliveryId", "delivery.deliveredAt", "history.previousStates"] }
        },
        "nonClaims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

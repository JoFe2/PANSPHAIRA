{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.dev/schemas/contracts/incoming-invoice-erv-v1.schema.json",
  "title": "Local synthetic incoming-invoice ERV capability core v1",
  "description": "Validates the local, deterministic decision/evidence package produced by the AP-04 ERV capability core. It asserts the schema version, the frozen local authority (no customer data, no external provider, no productive posting, no booking authority, Risk-D separately authorized), the frozen nonclaims, the deterministic readback, and the four-branch per-case decision discriminated union. It never claims live ERP evaluation, allocation, posting or booking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "package"
  ],
  "properties": {
    "outcome": {
      "const": "DECIDED"
    },
    "package": {
      "$ref": "#/$defs/corePackage"
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchingModeId",
        "matchingModeVersion",
        "tolerancePolicyId",
        "tolerancePolicyVersion"
      ],
      "properties": {
        "matchingModeId": {
          "minLength": 1,
          "type": "string"
        },
        "matchingModeVersion": {
          "minLength": 1,
          "type": "string"
        },
        "tolerancePolicyId": {
          "minLength": 1,
          "type": "string"
        },
        "tolerancePolicyVersion": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "evidenceCitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceKind",
          "referenceId",
          "contentSha256",
          "verified"
        ],
        "properties": {
          "referenceKind": {
            "enum": [
              "SUPPLIER",
              "PURCHASE_ORDER",
              "RECEIPT",
              "INVOICE"
            ]
          },
          "referenceId": {
            "minLength": 1,
            "type": "string"
          },
          "contentSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions",
        "advisorAuthority",
        "bookingAuthorityGranted"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "questionText",
              "citations"
            ],
            "properties": {
              "questionId": {
                "minLength": 1,
                "type": "string"
              },
              "questionText": {
                "minLength": 1,
                "type": "string"
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "referenceKind",
                    "referenceId",
                    "evidenceSha256"
                  ],
                  "properties": {
                    "referenceKind": {
                      "enum": [
                        "SUPPLIER",
                        "PURCHASE_ORDER",
                        "RECEIPT",
                        "INVOICE"
                      ]
                    },
                    "referenceId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "evidenceSha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "advisorAuthority": {
          "const": "EVIDENCE_CITING_ONLY"
        },
        "bookingAuthorityGranted": {
          "const": false
        }
      }
    },
    "caseAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productivePostingAuthorized",
        "bookingAuthorityGranted",
        "riskDCapability"
      ],
      "properties": {
        "productivePostingAuthorized": {
          "const": false
        },
        "bookingAuthorityGranted": {
          "const": false
        },
        "riskDCapability": {
          "const": "SEPARATELY_AUTHORIZED"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minReferenceId",
        "minAmountMinor",
        "maxReferenceId",
        "maxAmountMinor",
        "deltaMinor",
        "toleranceMinor",
        "tolerancePolicyId",
        "tolerancePolicyVersion"
      ],
      "properties": {
        "minReferenceId": {
          "minLength": 1,
          "type": "string"
        },
        "minAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "maxReferenceId": {
          "minLength": 1,
          "type": "string"
        },
        "maxAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "deltaMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "toleranceMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "tolerancePolicyId": {
          "minLength": 1,
          "type": "string"
        },
        "tolerancePolicyVersion": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "decisionMatched": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "matchedAmountMinor",
        "evidenceCitations",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "MATCHED"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "matchedAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "conflict",
        "evidenceCitations",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "CONFLICT"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "conflict": {
          "$ref": "#/$defs/conflict"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "exceptionCode",
        "detail",
        "evidenceCitations",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "EXCEPTION"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "exceptionCode": {
          "enum": [
            "MISSING_CONTEXT",
            "UNVERIFIED_REFERENCE_EVIDENCE",
            "UNKNOWN_VARIANT"
          ]
        },
        "detail": {
          "minLength": 1,
          "type": "string"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "reasonCode",
        "detail",
        "evidenceCitations",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "DENIED"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "reasonCode": {
          "const": "RISK_D_AUTHORIZATION_REQUIRED"
        },
        "detail": {
          "minLength": 1,
          "type": "string"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/decisionMatched"
        },
        {
          "$ref": "#/$defs/decisionConflict"
        },
        {
          "$ref": "#/$defs/decisionException"
        },
        {
          "$ref": "#/$defs/decisionDenied"
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "customerDataAuthorized",
        "externalProviderCalls",
        "productivePostingAuthorized",
        "bookingAuthorityGranted",
        "riskDCapability"
      ],
      "properties": {
        "mode": {
          "const": "LOCAL_SYNTHETIC_PROOF"
        },
        "customerDataAuthorized": {
          "const": false
        },
        "externalProviderCalls": {
          "const": false
        },
        "productivePostingAuthorized": {
          "const": false
        },
        "bookingAuthorityGranted": {
          "const": false
        },
        "riskDCapability": {
          "const": "SEPARATELY_AUTHORIZED"
        }
      }
    },
    "corePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packId",
        "caseCount",
        "decisions",
        "authority",
        "nonclaims",
        "readback"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chimpmaera.incoming-invoice/erv-core/v1"
        },
        "packId": {
          "minLength": 1,
          "type": "string"
        },
        "caseCount": {
          "minimum": 1,
          "type": "integer"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "nonclaims": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "NO_CUSTOMER_DATA_EVALUATED"
            },
            {
              "const": "NO_EXTERNAL_PROVIDER_EVALUATED"
            },
            {
              "const": "NO_PRODUCTIVE_ALLOCATION_OR_POSTING_AUTHORIZED"
            },
            {
              "const": "NO_BOOKING_AUTHORITY_GRANTED"
            },
            {
              "const": "NO_LIVE_ERP_SYSTEM_CLAIM"
            }
          ],
          "items": false
        },
        "readback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packSha256",
            "decisionDigest",
            "deterministicReplay"
          ],
          "properties": {
            "packSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "decisionDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "deterministicReplay": {
              "const": true
            }
          }
        }
      }
    }
  }
}

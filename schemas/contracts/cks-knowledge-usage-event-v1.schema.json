{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/cks-knowledge-usage-event-v1.schema.json",
  "title": "CKS-08 knowledge usage event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "semanticRuleId", "eventId", "eventType", "scopeRef", "taskRef", "occurredAtMs", "receivedAtMs", "scopeSequence", "previousEventDigest", "fact", "factDigest", "eventDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.knowledge/usage-lineage-event/v1" },
    "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" },
    "eventId": { "type": "string", "pattern": "^lineage-event:v1:[a-f0-9]{64}$" },
    "eventType": { "enum": ["TASK_OPENED", "SEARCH_RECORDED", "KNOWLEDGE_INSPECTED", "KNOWLEDGE_DISPOSITIONED", "DECISION_RECORDED", "EXECUTION_RECEIPT_RECORDED", "TASK_INPUT_RECEIPT_RECORDED", "EXTERNAL_RECEIPT_RECORDED", "GOVERNANCE_RECEIPT_RECORDED", "OUTCOME_RECORDED"] },
    "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" },
    "occurredAtMs": { "$ref": "#/$defs/timestamp" }, "receivedAtMs": { "$ref": "#/$defs/timestamp" }, "scopeSequence": { "type": "integer", "minimum": 0 }, "previousEventDigest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "fact": { "$ref": "#/$defs/fact" }, "factDigest": { "$ref": "#/$defs/digest" }, "eventDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "if": { "properties": { "eventType": { "const": "EXECUTION_RECEIPT_RECORDED" } }, "required": ["eventType"] }, "then": { "properties": { "fact": { "type": "object", "required": ["receipt"], "properties": { "receipt": { "type": "object", "properties": { "failureClass": { "const": "EXECUTION" } } } } } } } },
    { "if": { "properties": { "eventType": { "const": "TASK_INPUT_RECEIPT_RECORDED" } }, "required": ["eventType"] }, "then": { "properties": { "fact": { "type": "object", "required": ["receipt"], "properties": { "receipt": { "type": "object", "properties": { "failureClass": { "const": "TASK_INPUT" } } } } } } } },
    { "if": { "properties": { "eventType": { "const": "EXTERNAL_RECEIPT_RECORDED" } }, "required": ["eventType"] }, "then": { "properties": { "fact": { "type": "object", "required": ["receipt"], "properties": { "receipt": { "type": "object", "properties": { "failureClass": { "const": "EXTERNAL" } } } } } } } },
    { "if": { "properties": { "eventType": { "const": "GOVERNANCE_RECEIPT_RECORDED" } }, "required": ["eventType"] }, "then": { "properties": { "fact": { "type": "object", "required": ["receipt"], "properties": { "receipt": { "type": "object", "properties": { "failureClass": { "const": "GOVERNANCE" } } } } } } } },
    { "if": { "properties": { "fact": { "type": "object", "properties": { "receipt": true }, "required": ["receipt"] } }, "required": ["fact"] }, "then": { "properties": { "eventType": { "enum": ["EXECUTION_RECEIPT_RECORDED", "TASK_INPUT_RECEIPT_RECORDED", "EXTERNAL_RECEIPT_RECORDED", "GOVERNANCE_RECEIPT_RECORDED"] } } } }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "timestamp": { "type": "integer", "minimum": 0 },
    "scopeRef": { "type": "object", "additionalProperties": false, "required": ["scopeId", "scopeDigest"], "properties": { "scopeId": { "type": "string", "pattern": "^scope:v1:[a-f0-9]{64}$" }, "scopeDigest": { "$ref": "#/$defs/digest" } } },
    "taskRef": { "type": "object", "additionalProperties": false, "required": ["taskId", "taskDigest"], "properties": { "taskId": { "type": "string", "pattern": "^task:v1:[a-f0-9]{64}$" }, "taskDigest": { "$ref": "#/$defs/digest" } } },
    "searchRef": { "type": "object", "additionalProperties": false, "required": ["searchId", "searchDigest"], "properties": { "searchId": { "type": "string", "pattern": "^search:v1:[a-f0-9]{64}$" }, "searchDigest": { "$ref": "#/$defs/digest" } } },
    "knowledgeRef": { "type": "object", "additionalProperties": false, "required": ["knowledgeId", "knowledgeDigest"], "properties": { "knowledgeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" }, "knowledgeDigest": { "$ref": "#/$defs/digest" } } },
    "decisionRef": { "type": "object", "additionalProperties": false, "required": ["decisionId", "decisionDigest"], "properties": { "decisionId": { "type": "string", "pattern": "^decision:v1:[a-f0-9]{64}$" }, "decisionDigest": { "$ref": "#/$defs/digest" } } },
    "eventRef": { "type": "object", "additionalProperties": false, "required": ["eventId", "eventDigest"], "properties": { "eventId": { "type": "string", "pattern": "^lineage-event:v1:[a-f0-9]{64}$" }, "eventDigest": { "$ref": "#/$defs/digest" } } },
    "task": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "semanticRuleId", "scopeRef", "taskId", "taskKind", "objectiveDigest", "applicabilityContextDigest", "taskSemanticDigest", "contextFingerprintDigest", "taskDigest"], "properties": { "schemaVersion": { "const": "chimpmaera.knowledge/usage-lineage-task/v1" }, "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" }, "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskId": { "type": "string", "pattern": "^task:v1:[a-f0-9]{64}$" }, "taskKind": { "enum": ["RETRIEVE", "DECIDE", "ACT", "VERIFY"] }, "objectiveDigest": { "$ref": "#/$defs/digest" }, "applicabilityContextDigest": { "$ref": "#/$defs/digest" }, "taskSemanticDigest": { "$ref": "#/$defs/digest" }, "contextFingerprintDigest": { "$ref": "#/$defs/digest" }, "taskDigest": { "$ref": "#/$defs/digest" } } },
    "taskRefForEntity": { "$ref": "#/$defs/taskRef" },
    "search": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "semanticRuleId", "scopeRef", "taskRef", "searchId", "searchIntentDigest", "resultKnowledgeRefs", "searchDigest"], "properties": { "schemaVersion": { "const": "chimpmaera.knowledge/usage-lineage-search/v1" }, "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" }, "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" }, "searchId": { "type": "string", "pattern": "^search:v1:[a-f0-9]{64}$" }, "searchIntentDigest": { "$ref": "#/$defs/digest" }, "resultKnowledgeRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/knowledgeRef" } }, "searchDigest": { "$ref": "#/$defs/digest" } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "semanticRuleId", "scopeRef", "taskRef", "decisionId", "decisionClass", "supportingKnowledgeRefs", "decisionDigest"], "properties": { "schemaVersion": { "const": "chimpmaera.knowledge/usage-lineage-decision/v1" }, "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" }, "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" }, "decisionId": { "type": "string", "pattern": "^decision:v1:[a-f0-9]{64}$" }, "decisionClass": { "enum": ["SELECTED", "REJECTED", "DEFERRED", "DENIED"] }, "supportingKnowledgeRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/knowledgeRef" } }, "decisionDigest": { "$ref": "#/$defs/digest" } } },
    "directFailureReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "semanticRuleId", "scopeRef", "taskRef", "decisionRef", "failureClass", "failureSubtype", "evidenceDigest", "receiptDigest"],
      "properties": {
        "schemaVersion": { "const": "chimpmaera.knowledge/direct-failure-receipt/v1" },
        "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" },
        "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" }, "decisionRef": { "$ref": "#/$defs/decisionRef" },
        "failureClass": { "enum": ["EXECUTION", "TASK_INPUT", "EXTERNAL", "GOVERNANCE"] },
        "failureSubtype": { "enum": ["ACTION_FAILED", "READBACK_FAILED", "MISSING_CONTEXT", "INVALID_INPUT", "DEPENDENCY_UNAVAILABLE", "ENVIRONMENT_DRIFT", "POLICY_DENIED", "AUTHORITY_DENIED"] },
        "evidenceDigest": { "$ref": "#/$defs/digest" }, "receiptDigest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        { "if": { "properties": { "failureClass": { "const": "EXECUTION" } } }, "then": { "properties": { "failureSubtype": { "enum": ["ACTION_FAILED", "READBACK_FAILED"] } } } },
        { "if": { "properties": { "failureClass": { "const": "TASK_INPUT" } } }, "then": { "properties": { "failureSubtype": { "enum": ["MISSING_CONTEXT", "INVALID_INPUT"] } } } },
        { "if": { "properties": { "failureClass": { "const": "EXTERNAL" } } }, "then": { "properties": { "failureSubtype": { "enum": ["DEPENDENCY_UNAVAILABLE", "ENVIRONMENT_DRIFT"] } } } },
        { "if": { "properties": { "failureClass": { "const": "GOVERNANCE" } } }, "then": { "properties": { "failureSubtype": { "enum": ["POLICY_DENIED", "AUTHORITY_DENIED"] } } } }
      ]
    },
    "failureAttribution": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "semanticRuleId", "causalMode", "causes", "failureAttributionDigest"], "properties": { "schemaVersion": { "const": "chimpmaera.knowledge/failure-attribution/v1" }, "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" }, "causalMode": { "enum": ["NOT_APPLICABLE", "SINGLE", "MULTI_CONTRIBUTING", "MULTI_JOINT", "ALTERNATIVES_UNRESOLVED", "UNKNOWN"] }, "causes": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/cause" } }, "failureAttributionDigest": { "$ref": "#/$defs/digest" } } },
    "cause": { "type": "object", "additionalProperties": false, "required": ["class", "subtype", "certainty", "causeEventRefs", "affectedKnowledgeRefs"], "properties": { "class": { "enum": ["KNOWLEDGE", "SEARCH", "DECISION", "EXECUTION", "TASK_INPUT", "EXTERNAL", "GOVERNANCE", "UNKNOWN"] }, "subtype": { "type": "string", "enum": ["SOURCE_DEFECT", "APPLICABILITY_MISMATCH", "STALE", "CONTRADICTED", "MISSING", "UNSUPPORTED_GENERALIZATION", "RELEVANT_NOT_RETURNED", "RELEVANT_NOT_INSPECTED", "RELEVANT_REJECTED", "UNSUPPORTED_SELECTION", "SUPPORTED_OPTION_IGNORED", "ACTION_FAILED", "READBACK_FAILED", "MISSING_CONTEXT", "INVALID_INPUT", "DEPENDENCY_UNAVAILABLE", "ENVIRONMENT_DRIFT", "POLICY_DENIED", "AUTHORITY_DENIED", "INSUFFICIENT_CAUSAL_EVIDENCE"] }, "certainty": { "enum": ["CONFIRMED", "SUPPORTED", "POSSIBLE", "UNKNOWN"] }, "causeEventRefs": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/eventRef" } }, "affectedKnowledgeRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/knowledgeRef" } } } },
    "outcome": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "semanticRuleId", "scopeRef", "taskRef", "decisionRef", "outcomeId", "outcomeClass", "contributingKnowledgeRefs", "failureAttribution", "outcomeDigest"], "properties": { "schemaVersion": { "const": "chimpmaera.knowledge/usage-lineage-outcome/v1" }, "semanticRuleId": { "const": "chimpmaera.knowledge/usage-lineage-semantics/v1" }, "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" }, "decisionRef": { "$ref": "#/$defs/decisionRef" }, "outcomeId": { "type": "string", "pattern": "^outcome:v1:[a-f0-9]{64}$" }, "outcomeClass": { "enum": ["SUCCEEDED", "FAILED", "PARTIAL", "DENIED", "UNKNOWN"] }, "contributingKnowledgeRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/knowledgeRef" } }, "failureAttribution": { "$ref": "#/$defs/failureAttribution" }, "outcomeDigest": { "$ref": "#/$defs/digest" } } },
    "fact": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["task"], "properties": { "task": { "$ref": "#/$defs/task" } } }, { "type": "object", "additionalProperties": false, "required": ["search"], "properties": { "search": { "$ref": "#/$defs/search" } } }, { "type": "object", "additionalProperties": false, "required": ["scopeRef", "taskRef", "searchRef", "knowledgeRef"], "properties": { "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" }, "searchRef": { "$ref": "#/$defs/searchRef" }, "knowledgeRef": { "$ref": "#/$defs/knowledgeRef" } } }, { "type": "object", "additionalProperties": false, "required": ["scopeRef", "taskRef", "knowledgeRef", "disposition", "reasonCode"], "properties": { "scopeRef": { "$ref": "#/$defs/scopeRef" }, "taskRef": { "$ref": "#/$defs/taskRef" }, "knowledgeRef": { "$ref": "#/$defs/knowledgeRef" }, "disposition": { "enum": ["USED", "REJECTED"] }, "reasonCode": { "enum": ["SELECTED_FOR_TASK", "NOT_APPLICABLE", "STALE", "CONTRADICTED", "INSUFFICIENT_SOURCE_SUPPORT", "NOT_NEEDED", "POLICY_DENIED"] } } }, { "type": "object", "additionalProperties": false, "required": ["decision"], "properties": { "decision": { "$ref": "#/$defs/decision" } } }, { "type": "object", "additionalProperties": false, "required": ["receipt"], "properties": { "receipt": { "$ref": "#/$defs/directFailureReceipt" } } }, { "type": "object", "additionalProperties": false, "required": ["outcome"], "properties": { "outcome": { "$ref": "#/$defs/outcome" } } } ] }
  }
}

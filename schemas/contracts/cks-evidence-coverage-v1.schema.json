{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/cks-evidence-coverage-v1.schema.json",
  "title": "ChimpMaera CKS Evidence Coverage binding v1",
  "description": "Closed, authority-free coverage results preserving COMPLETE, CONFLICT, MISSING, and STALE states for material claims. This record does not assert truth, trust, execution, release, delivery, or authorization. Unknown versions require an explicit migration; v1 has no implicit migration path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coverageId", "pack", "scopeNamespace", "evaluatedAtMs", "status", "claims", "authority", "coverageDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.cks/evidence-coverage/v1" },
    "coverageId": { "$ref": "#/$defs/id" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "packDigest"],
      "properties": {
        "packId": { "$ref": "#/$defs/id" },
        "packDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "scopeNamespace": { "$ref": "#/$defs/text" },
    "evaluatedAtMs": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["COMPLETE", "CONFLICT", "MISSING", "STALE"] },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/coverageClaim" }
    },
    "authority": { "$ref": "#/$defs/authority" },
    "coverageDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\u0000-\\u001f]+$" },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "coverageClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "state"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "state": { "enum": ["COMPLETE", "CONFLICT", "MISSING", "STALE"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials", "policyApprovals", "capabilities", "toolAccess", "writeTargets", "executionRoutes"],
      "properties": {
        "credentials": { "type": "array", "maxItems": 0 },
        "policyApprovals": { "type": "array", "maxItems": 0 },
        "capabilities": { "type": "array", "maxItems": 0 },
        "toolAccess": { "type": "array", "maxItems": 0 },
        "writeTargets": { "type": "array", "maxItems": 0 },
        "executionRoutes": { "type": "array", "maxItems": 0 }
      }
    }
  }
}

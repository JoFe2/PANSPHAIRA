{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/PANSPHAIRA/schemas/contracts/cks-knowledge-sufficiency-v1.schema.json",
  "title": "PANSPHAIRA CKS KnowledgeSufficiency v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sufficiencyId", "caseId", "requirementSetDigest", "knowledgeBundleDigest", "requirements", "blockedReasons", "overallOutcome", "authorityBoundary", "sufficiencyDigest"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.cks/knowledge-sufficiency/v1" },
    "sufficiencyId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "requirementSetDigest": { "$ref": "#/$defs/digest" },
    "knowledgeBundleDigest": { "$ref": "#/$defs/digest" },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/requirement" } },
    "blockedReasons": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "enum": ["DEPENDENCY_EVIDENCE_ABSENT", "DEPENDENCY_SCHEMA_INVALID", "DEPENDENCY_DIGEST_MISMATCH", "REQUIRED_SEMANTIC_RULE_ABSENT", "REQUIRED_APPLICABILITY_RULE_ABSENT", "REQUIRED_SOURCE_RULE_ABSENT", "RETRIEVAL_RECEIPT_ABSENT", "DENOMINATOR_EVIDENCE_ABSENT", "COMPARATOR_INPUT_ABSENT", "UNKNOWN_VOCABULARY_VALUE"] } },
    "overallOutcome": { "enum": ["SUFFICIENT", "INSUFFICIENT", "BLOCKED"] },
    "authorityBoundary": { "const": "READ_ONLY_KNOWLEDGE_NO_CREDENTIAL_POLICY_CAPABILITY_TOOL_WRITE_OR_EXECUTION_AUTHORITY" },
    "sufficiencyDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "if": { "properties": { "overallOutcome": { "const": "BLOCKED" } }, "required": ["overallOutcome"] }, "then": { "properties": { "blockedReasons": { "type": "array", "minItems": 1 } } } },
    { "if": { "properties": { "overallOutcome": { "enum": ["SUFFICIENT", "INSUFFICIENT"] } }, "required": ["overallOutcome"] }, "then": { "properties": { "blockedReasons": { "type": "array", "maxItems": 0 } } } }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "sourceClass": { "enum": ["ACTIVE_CURATED_KNOWLEDGE", "PINNED_OWNER_EVIDENCE", "PINNED_PRIMARY_EVIDENCE", "PINNED_SECONDARY_EVIDENCE", "INTERNET_RESULT", "MODEL_RESULT", "UNKNOWN_SOURCE"] },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["needDigest", "gapClass", "requirementOutcome", "sourceClasses", "evidenceDigests"],
      "properties": {
        "needDigest": { "$ref": "#/$defs/digest" },
        "gapClass": { "enum": ["NONE", "MISSING", "BAD_SOURCE", "APPLICABILITY", "CONFLICTING", "UNKNOWN_SEMANTIC"] },
        "requirementOutcome": { "enum": ["SATISFIED", "NOT_APPLICABLE", "GAP_MISSING", "GAP_BAD_SOURCE", "GAP_APPLICABILITY", "GAP_CONFLICTING", "GAP_UNKNOWN_SEMANTIC"] },
        "sourceClasses": { "type": "array", "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceClass" } },
        "evidenceDigests": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
      },
      "allOf": [
        { "if": { "properties": { "gapClass": { "const": "NONE" } }, "required": ["gapClass"] }, "then": { "properties": { "requirementOutcome": { "enum": ["SATISFIED", "NOT_APPLICABLE"] } } } },
        { "if": { "properties": { "requirementOutcome": { "const": "SATISFIED" } }, "required": ["requirementOutcome"] }, "then": { "properties": { "gapClass": { "const": "NONE" }, "sourceClasses": { "type": "array", "minItems": 1, "contains": { "const": "ACTIVE_CURATED_KNOWLEDGE" } } } } },
        { "if": { "properties": { "requirementOutcome": { "const": "NOT_APPLICABLE" } }, "required": ["requirementOutcome"] }, "then": { "properties": { "gapClass": { "const": "NONE" }, "sourceClasses": { "type": "array", "maxItems": 0 } } } },
        { "if": { "properties": { "gapClass": { "const": "MISSING" } }, "required": ["gapClass"] }, "then": { "properties": { "requirementOutcome": { "const": "GAP_MISSING" } } } },
        { "if": { "properties": { "gapClass": { "const": "BAD_SOURCE" } }, "required": ["gapClass"] }, "then": { "properties": { "requirementOutcome": { "const": "GAP_BAD_SOURCE" } } } },
        { "if": { "properties": { "gapClass": { "const": "APPLICABILITY" } }, "required": ["gapClass"] }, "then": { "properties": { "requirementOutcome": { "const": "GAP_APPLICABILITY" } } } },
        { "if": { "properties": { "gapClass": { "const": "CONFLICTING" } }, "required": ["gapClass"] }, "then": { "properties": { "requirementOutcome": { "const": "GAP_CONFLICTING" } } } },
        { "if": { "properties": { "gapClass": { "const": "UNKNOWN_SEMANTIC" } }, "required": ["gapClass"] }, "then": { "properties": { "requirementOutcome": { "const": "GAP_UNKNOWN_SEMANTIC" } } } }
      ]
    }
  }
}

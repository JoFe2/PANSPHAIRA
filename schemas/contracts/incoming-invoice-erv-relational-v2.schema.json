{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.dev/schemas/contracts/incoming-invoice-erv-relational-v2.schema.json",
  "title": "Local synthetic incoming-invoice ERV relational hardening core v2",
  "description": "Validates the local, deterministic decision/evidence package produced by the AP-04 relational hardening slice (v2). It asserts the schema version, the frozen local authority (no customer data, no external provider, no productive posting, no booking authority, Risk-D separately authorized), the frozen nonclaims including the explicit no-system-of-record-readback nonclaim, the deterministic replay block (repeating this local compiler is deterministic replay, never an external or system-of-record readback), and the five-branch per-case decision discriminated union. Every decision carries four distinct evidence dimensions: integrityVerified, originVerified, semanticsVerified and runtimeObserved. It never claims live ERP evaluation, allocation, posting, booking or readback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "package"
  ],
  "properties": {
    "outcome": {
      "const": "DECIDED"
    },
    "package": {
      "$ref": "#/$defs/corePackage"
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchingModeId",
        "matchingModeVersion",
        "tolerancePolicyId",
        "tolerancePolicyVersion"
      ],
      "properties": {
        "matchingModeId": {
          "minLength": 1,
          "type": "string"
        },
        "matchingModeVersion": {
          "minLength": 1,
          "type": "string"
        },
        "tolerancePolicyId": {
          "minLength": 1,
          "type": "string"
        },
        "tolerancePolicyVersion": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "evidenceCitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceKind",
          "referenceId",
          "contentSha256",
          "recomputedContentSha256",
          "integrityVerified",
          "originVerified"
        ],
        "properties": {
          "referenceKind": {
            "enum": [
              "SUPPLIER",
              "PURCHASE_ORDER",
              "RECEIPT",
              "INVOICE"
            ]
          },
          "referenceId": {
            "minLength": 1,
            "type": "string"
          },
          "contentSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "recomputedContentSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "integrityVerified": {
            "type": "boolean"
          },
          "originVerified": {
            "type": "boolean"
          }
        }
      }
    },
    "evidenceDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrityVerified",
        "originVerified",
        "semanticsVerified",
        "runtimeObserved"
      ],
      "properties": {
        "integrityVerified": {
          "type": "boolean"
        },
        "originVerified": {
          "type": "boolean"
        },
        "semanticsVerified": {
          "type": "boolean"
        },
        "runtimeObserved": {
          "const": true
        }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions",
        "advisorAuthority",
        "bookingAuthorityGranted"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "questionText",
              "citations"
            ],
            "properties": {
              "questionId": {
                "minLength": 1,
                "type": "string"
              },
              "questionText": {
                "minLength": 1,
                "type": "string"
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "referenceKind",
                    "referenceId",
                    "evidenceSha256"
                  ],
                  "properties": {
                    "referenceKind": {
                      "enum": [
                        "SUPPLIER",
                        "PURCHASE_ORDER",
                        "RECEIPT",
                        "INVOICE"
                      ]
                    },
                    "referenceId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "evidenceSha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "advisorAuthority": {
          "const": "EVIDENCE_CITING_ONLY"
        },
        "bookingAuthorityGranted": {
          "const": false
        }
      }
    },
    "caseAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productivePostingAuthorized",
        "bookingAuthorityGranted",
        "riskDCapability"
      ],
      "properties": {
        "productivePostingAuthorized": {
          "const": false
        },
        "bookingAuthorityGranted": {
          "const": false
        },
        "riskDCapability": {
          "const": "SEPARATELY_AUTHORIZED"
        }
      }
    },
    "conflictAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictKind",
        "minReferenceId",
        "minAmountMinor",
        "maxReferenceId",
        "maxAmountMinor",
        "deltaMinor",
        "toleranceMinor",
        "tolerancePolicyId",
        "tolerancePolicyVersion"
      ],
      "properties": {
        "conflictKind": {
          "const": "AMOUNT"
        },
        "minReferenceId": {
          "minLength": 1,
          "type": "string"
        },
        "minAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "maxReferenceId": {
          "minLength": 1,
          "type": "string"
        },
        "maxAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "deltaMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "toleranceMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "tolerancePolicyId": {
          "minLength": 1,
          "type": "string"
        },
        "tolerancePolicyVersion": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "conflictRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictKind",
        "observed"
      ],
      "properties": {
        "conflictKind": {
          "enum": [
            "SUPPLIER_RELATION",
            "QUANTITY_RELATION",
            "UNIT_RELATION",
            "CURRENCY_RELATION"
          ]
        },
        "observed": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "referenceIds"
            ],
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ]
              },
              "referenceIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "conflict": {
      "oneOf": [
        {
          "$ref": "#/$defs/conflictAmount"
        },
        {
          "$ref": "#/$defs/conflictRelation"
        }
      ]
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplierId",
        "quantity",
        "unit",
        "currency"
      ],
      "properties": {
        "supplierId": {
          "minLength": 1,
          "type": "string"
        },
        "quantity": {
          "minimum": 0,
          "type": "integer"
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        },
        "currency": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownKind",
        "matchedAmountMinor",
        "toleranceMinor",
        "detail"
      ],
      "properties": {
        "unknownKind": {
          "const": "SUPPLIER_RELATION_NOT_VERIFIED"
        },
        "matchedAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "toleranceMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "detail": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "decisionMatched": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "matchedAmountMinor",
        "relations",
        "evidenceCitations",
        "evidenceDimensions",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "MATCHED"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "matchedAmountMinor": {
          "minimum": 0,
          "type": "integer"
        },
        "relations": {
          "$ref": "#/$defs/relations"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "evidenceDimensions": {
          "$ref": "#/$defs/evidenceDimensions"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "conflict",
        "evidenceCitations",
        "evidenceDimensions",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "CONFLICT"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "conflict": {
          "$ref": "#/$defs/conflict"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "evidenceDimensions": {
          "$ref": "#/$defs/evidenceDimensions"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "unknown",
        "evidenceCitations",
        "evidenceDimensions",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "UNKNOWN"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "unknown": {
          "$ref": "#/$defs/unknown"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "evidenceDimensions": {
          "$ref": "#/$defs/evidenceDimensions"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "exceptionCode",
        "detail",
        "evidenceCitations",
        "evidenceDimensions",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "EXCEPTION"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "exceptionCode": {
          "enum": [
            "UNVERIFIED_REFERENCE_EVIDENCE",
            "ORIGIN_NOT_VERIFIED",
            "DUPLICATE_REFERENCE_KIND",
            "MISSING_CONTEXT",
            "UNKNOWN_VARIANT"
          ]
        },
        "detail": {
          "minLength": 1,
          "type": "string"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "evidenceDimensions": {
          "$ref": "#/$defs/evidenceDimensions"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decisionDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "variant",
        "reasonCode",
        "detail",
        "evidenceCitations",
        "evidenceDimensions",
        "advisor",
        "authority"
      ],
      "properties": {
        "caseId": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "const": "DENIED"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "reasonCode": {
          "const": "RISK_D_AUTHORIZATION_REQUIRED"
        },
        "detail": {
          "minLength": 1,
          "type": "string"
        },
        "evidenceCitations": {
          "$ref": "#/$defs/evidenceCitations"
        },
        "evidenceDimensions": {
          "$ref": "#/$defs/evidenceDimensions"
        },
        "advisor": {
          "$ref": "#/$defs/advisor"
        },
        "authority": {
          "$ref": "#/$defs/caseAuthority"
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/decisionMatched"
        },
        {
          "$ref": "#/$defs/decisionConflict"
        },
        {
          "$ref": "#/$defs/decisionUnknown"
        },
        {
          "$ref": "#/$defs/decisionException"
        },
        {
          "$ref": "#/$defs/decisionDenied"
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "customerDataAuthorized",
        "externalProviderCalls",
        "productivePostingAuthorized",
        "bookingAuthorityGranted",
        "riskDCapability"
      ],
      "properties": {
        "mode": {
          "const": "LOCAL_SYNTHETIC_PROOF"
        },
        "customerDataAuthorized": {
          "const": false
        },
        "externalProviderCalls": {
          "const": false
        },
        "productivePostingAuthorized": {
          "const": false
        },
        "bookingAuthorityGranted": {
          "const": false
        },
        "riskDCapability": {
          "const": "SEPARATELY_AUTHORIZED"
        }
      }
    },
    "corePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packId",
        "caseCount",
        "decisions",
        "authority",
        "nonclaims",
        "deterministicReplay"
      ],
      "properties": {
        "schemaVersion": {
          "const": "chimpmaera.incoming-invoice/erv-relational-core/v2"
        },
        "packId": {
          "minLength": 1,
          "type": "string"
        },
        "caseCount": {
          "minimum": 1,
          "type": "integer"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "nonclaims": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "NO_CUSTOMER_DATA_EVALUATED"
            },
            {
              "const": "NO_EXTERNAL_PROVIDER_EVALUATED"
            },
            {
              "const": "NO_PRODUCTIVE_ALLOCATION_OR_POSTING_AUTHORIZED"
            },
            {
              "const": "NO_BOOKING_AUTHORITY_GRANTED"
            },
            {
              "const": "NO_LIVE_ERP_SYSTEM_CLAIM"
            },
            {
              "const": "NO_SYSTEM_OF_RECORD_READBACK_PERFORMED"
            }
          ],
          "items": false
        },
        "deterministicReplay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packSha256",
            "decisionDigest",
            "policy"
          ],
          "properties": {
            "packSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "decisionDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "policy": {
              "const": "LOCAL_COMPILER_DETERMINISTIC_REPLAY"
            }
          }
        }
      }
    }
  }
}

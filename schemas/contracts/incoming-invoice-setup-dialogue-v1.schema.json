{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/contracts/incoming-invoice-setup-dialogue-v1.schema.json",
  "title": "ChimpMaera incoming-invoice setup dialogue transcript v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transcriptVersion", "syntheticEvidence", "turns", "transcriptDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.incoming-invoice/setup-dialogue/v1" },
    "transcriptVersion": { "const": "1.0.0" },
    "syntheticEvidence": { "const": true },
    "turns": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/turn" } },
    "transcriptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requirementId", "matchingMode", "tolerancePolicy", "requestedEffects", "evidenceRefs", "synthetic", "customerData"],
      "properties": {
        "schemaVersion": { "const": "chimpmaera.incoming-invoice/erv-requirement/v1" },
        "requirementId": { "type": "string", "minLength": 1 },
        "matchingMode": { "$ref": "#/$defs/variant" },
        "tolerancePolicy": { "$ref": "#/$defs/variant" },
        "requestedEffects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "synthetic": { "const": true },
        "customerData": { "const": false }
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false, "required": ["variantId", "version"],
      "properties": { "variantId": { "type": "string", "minLength": 1 }, "version": { "const": "1.0.0" } }
    },
    "answer": {
      "type": "object", "additionalProperties": false, "required": ["questionId", "answer"],
      "properties": { "questionId": { "type": "string", "minLength": 1 }, "answer": { "enum": ["CONFIRM", "DECLINE"] } }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["questionId", "question"],
      "properties": { "questionId": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 } }
    },
    "outcomeResolved": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "configurationDeltaDigest"],
      "properties": { "outcome": { "const": "RESOLVED" }, "configurationDeltaDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "outcomeUnresolved": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "gaps"],
      "properties": { "outcome": { "enum": ["NEEDS_CLARIFICATION", "DENIED_UNSUPPORTED"] }, "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "invalid": {
      "type": "object", "additionalProperties": false, "required": ["invalid"],
      "properties": { "invalid": { "const": true } }
    },
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "speaker", "kind", "payload", "evidenceRefs"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "speaker": { "enum": ["SYSTEM", "AGENT", "OPERATOR"] },
        "kind": { "enum": ["BASELINE_REQUIREMENT", "CHANGED_REQUIREMENT", "CLARIFICATION", "ANSWER", "OUTCOME"] },
        "payload": { "oneOf": [
          { "$ref": "#/$defs/requirement" }, { "$ref": "#/$defs/answer" }, { "$ref": "#/$defs/question" },
          { "$ref": "#/$defs/outcomeResolved" }, { "$ref": "#/$defs/outcomeUnresolved" }, { "$ref": "#/$defs/invalid" }
        ] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

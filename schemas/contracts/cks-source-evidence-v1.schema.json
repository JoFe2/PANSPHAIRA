{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/PANSPHAIRA/schemas/contracts/cks-source-evidence-v1.schema.json",
  "title": "PANSPHAIRA CKS SourceEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "sourceClass", "locator", "contentDigest", "observedAtMs", "expiresAtMs", "licence", "acceptanceStatus", "authorityBoundary", "evidenceDigest"],
  "properties": {
    "schemaVersion": { "const": "pansphaira.cks/source-evidence/v1" },
    "evidenceId": { "$ref": "#/$defs/id" },
    "sourceClass": { "$ref": "#/$defs/sourceClass" },
    "locator": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u001f]+$" },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "observedAtMs": { "$ref": "#/$defs/timestamp" },
    "expiresAtMs": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "licence": { "enum": ["CC0-1.0", "CC-BY-4.0", "APACHE-2.0", "MIT", "OWNER_AUTHORIZED", "UNKNOWN"] },
    "acceptanceStatus": { "const": "NOT_ACCEPTED" },
    "authorityBoundary": { "const": "READ_ONLY_KNOWLEDGE_NO_CREDENTIAL_POLICY_CAPABILITY_TOOL_WRITE_OR_EXECUTION_AUTHORITY" },
    "evidenceDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer", "minimum": 0 },
    "sourceClass": { "enum": ["ACTIVE_CURATED_KNOWLEDGE", "PINNED_OWNER_EVIDENCE", "PINNED_PRIMARY_EVIDENCE", "PINNED_SECONDARY_EVIDENCE", "INTERNET_RESULT", "MODEL_RESULT", "UNKNOWN_SOURCE"] }
  }
}

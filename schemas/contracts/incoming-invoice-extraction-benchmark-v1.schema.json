{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.dev/schemas/contracts/incoming-invoice-extraction-benchmark-v1.schema.json",
  "title": "Local synthetic incoming-invoice extraction benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "schemaVersion", "holdoutId", "denominators", "systems", "errors", "authority", "nonclaims"],
  "properties": {
    "outcome": { "const": "PUBLISHED" },
    "schemaVersion": { "const": "chimpmaera.incoming-invoice/extraction-benchmark/v1" },
    "holdoutId": { "const": "ap-03-local-synthetic-holdout-v1" },
    "denominators": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "layout", "lineItems", "taxes", "totals", "confidence"],
      "properties": {
        "disposition": { "type": "integer", "minimum": 1 },
        "layout": { "type": "integer", "minimum": 1 },
        "lineItems": { "type": "integer", "minimum": 1 },
        "taxes": { "type": "integer", "minimum": 1 },
        "totals": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "integer", "minimum": 1 }
      }
    },
    "systems": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "boundedSyntheticModel"],
      "properties": {
        "baseline": { "$ref": "#/$defs/system" },
        "boundedSyntheticModel": { "$ref": "#/$defs/system" }
      }
    },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authoritativeOutputs", "productivePostingAuthorized", "customerDataAuthorized", "externalProviderCalls"],
      "properties": {
        "authoritativeOutputs": { "const": false },
        "productivePostingAuthorized": { "const": false },
        "customerDataAuthorized": { "const": false },
        "externalProviderCalls": { "const": false }
      }
    },
    "nonclaims": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "prefixItems": [
        { "const": "NO_CUSTOMER_DATA_EVALUATED" },
        { "const": "NO_EXTERNAL_PROVIDER_EVALUATED" },
        { "const": "NO_PRODUCTIVE_ALLOCATION_OR_POSTING_AUTHORIZED" },
        { "const": "NO_ARBITRARY_MODEL_CLAIM" },
        { "const": "NO_PRODUCTION_FITNESS_CLAIM" }
      ],
      "items": false
    }
  },
  "$defs": {
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "layout", "lineItems", "taxes", "totals"],
      "properties": {
        "disposition": { "type": "integer", "minimum": 0 },
        "layout": { "type": "integer", "minimum": 0 },
        "lineItems": { "type": "integer", "minimum": 0 },
        "taxes": { "type": "integer", "minimum": 0 },
        "totals": { "type": "integer", "minimum": 0 }
      }
    },
    "system": {
      "type": "object", "additionalProperties": false,
      "required": ["systemId", "proposalKind", "exactCorrect", "validation", "confidenceCalibration"],
      "properties": {
        "systemId": { "type": "string", "minLength": 1 },
        "proposalKind": { "enum": ["DETERMINISTIC_BASELINE", "BOUNDED_SYNTHETIC_MODEL_PROPOSAL"] },
        "exactCorrect": { "$ref": "#/$defs/counts" },
        "validation": {
          "type": "object", "additionalProperties": false, "required": ["validated", "rejected"],
          "properties": { "validated": { "type": "integer", "minimum": 0 }, "rejected": { "type": "integer", "minimum": 0 } }
        },
        "confidenceCalibration": {
          "type": "object", "additionalProperties": false, "required": ["brierScore", "bins"],
          "properties": {
            "brierScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "bins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibrationBin" } }
          }
        }
      }
    },
    "calibrationBin": {
      "type": "object", "additionalProperties": false,
      "required": ["lowerInclusive", "upperInclusive", "count", "meanConfidence", "observedExactDispositionAccuracy"],
      "properties": {
        "lowerInclusive": { "type": "number", "minimum": 0, "maximum": 1 },
        "upperInclusive": { "type": "number", "minimum": 0, "maximum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "meanConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedExactDispositionAccuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["systemId", "caseId", "dimension", "expected", "observed"],
      "properties": {
        "systemId": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "minLength": 1 },
        "dimension": { "enum": ["disposition", "layout", "lineItems", "taxes", "totals"] },
        "expected": { "type": "string" },
        "observed": { "type": "string" }
      }
    }
  }
}

{
  "$id": "https://chimpmaera.dev/schemas/contracts/cks-applicability-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChimpMaera CKS Applicability binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "object", "scopeNamespace", "acceptedContext", "materialDimensions", "authority", "applicabilityDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.cks/applicability/v1" },
    "object": { "$ref": "#/$defs/objectReference" },
    "scopeNamespace": { "$ref": "#/$defs/text" },
    "acceptedContext": { "$ref": "#/$defs/acceptedContext" },
    "materialDimensions": { "type": "array", "maxItems": 15, "uniqueItems": true, "items": { "$ref": "#/$defs/dimension" } },
    "authority": { "$ref": "#/$defs/authority" },
    "applicabilityDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\u0000-\\u001f]+$" },
    "dimension": { "enum": ["domain", "knowledge_type", "role_responsibility", "industry", "organization_context", "geography_jurisdiction_policy", "process_stage", "system_config", "prerequisites_constraints_exceptions", "task_audience_outcome", "valid_time_freshness", "epistemic_status", "evidence_strength", "sensitivity", "license"] },
    "objectReference": { "type": "object", "additionalProperties": false, "required": ["objectId", "objectDigest"], "properties": { "objectId": { "$ref": "#/$defs/id" }, "objectDigest": { "$ref": "#/$defs/digest" } } },
    "acceptedContext": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "domain": { "$ref": "#/$defs/contextValues" }, "knowledge_type": { "$ref": "#/$defs/contextValues" }, "role_responsibility": { "$ref": "#/$defs/contextValues" }, "industry": { "$ref": "#/$defs/contextValues" }, "organization_context": { "$ref": "#/$defs/contextValues" }, "geography_jurisdiction_policy": { "$ref": "#/$defs/contextValues" }, "process_stage": { "$ref": "#/$defs/contextValues" }, "system_config": { "$ref": "#/$defs/contextValues" }, "prerequisites_constraints_exceptions": { "$ref": "#/$defs/contextValues" }, "task_audience_outcome": { "$ref": "#/$defs/contextValues" }, "valid_time_freshness": { "$ref": "#/$defs/contextValues" }, "epistemic_status": { "$ref": "#/$defs/contextValues" }, "evidence_strength": { "$ref": "#/$defs/contextValues" }, "sensitivity": { "$ref": "#/$defs/contextValues" }, "license": { "$ref": "#/$defs/contextValues" }
      }
    },
    "contextValues": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f]+$" } },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["credentials", "policyApprovals", "capabilities", "toolAccess", "writeTargets", "executionRoutes"],
      "properties": {
        "credentials": { "type": "array", "maxItems": 0 }, "policyApprovals": { "type": "array", "maxItems": 0 },
        "capabilities": { "type": "array", "maxItems": 0 }, "toolAccess": { "type": "array", "maxItems": 0 },
        "writeTargets": { "type": "array", "maxItems": 0 }, "executionRoutes": { "type": "array", "maxItems": 0 }
      }
    }
  }
}

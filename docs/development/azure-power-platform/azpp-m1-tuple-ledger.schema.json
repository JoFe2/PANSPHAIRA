        "id": { "$ref": "#/$defs/publicIdentifier" },
        "version": { "$ref": "#/$defs/immutableVersion" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceIdentifier" },
        "ref": { "$ref": "#/$defs/publicRef" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "negativeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reasonCode", "evidenceRef"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceIdentifier" },
        "reasonCode": {
          "enum": [
            "MISSING_COMPONENT_DIGEST_DENIED",
            "MUTABLE_VERSION_DENIED",
            "PRIVATE_IDENTIFIER_DENIED",
            "UNKNOWN_FIELD_DENIED",
            "POLICY_GENERATION_MISMATCH_DENIED",
            "LKG_REVOKED_DENIED",
            "DIGEST_DRIFT_DENIED"
          ]
        },
        "evidenceRef": { "$ref": "#/$defs/evidenceIdentifier" }
      }
    },
    "acceptedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tupleDigest"],
      "properties": {
        "status": { "const": "ACCEPTED" },
        "tupleDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "lkgRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tupleDigest", "revocationStatus", "evidenceRefs"],
      "properties": {
        "status": { "const": "LKG" },
        "tupleDigest": { "$ref": "#/$defs/digest" },
        "revocationStatus": { "const": "UNREVOKED" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceIdentifier" }
        }
      }
    },
    "rollbackRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetTupleDigest", "targetStatus", "targetRevocationStatus", "evidenceRefs"],
      "properties": {
        "targetTupleDigest": { "$ref": "#/$defs/digest" },
        "targetStatus": { "const": "LKG" },
        "targetRevocationStatus": { "const": "UNREVOKED" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceIdentifier" }
        }
      }
    },
    "publicLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "$ref": "#/$defs/publicRef" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "planningArtifactLink": {
      "allOf": [
        { "$ref": "#/$defs/publicLink" },
        { "type": "object", "properties": { "ref": { "type": "string", "pattern": "^(docs|pull)/" } } }
      ]
    },
    "implementationPrLink": {
      "allOf": [
        { "$ref": "#/$defs/publicLink" },
        { "type": "object", "properties": { "ref": { "type": "string", "pattern": "^pull/" } } }
      ]
    },
    "releaseLink": {
      "allOf": [
        { "$ref": "#/$defs/publicLink" },
        { "type": "object", "properties": { "ref": { "type": "string", "pattern": "^release/" } } }
      ]
    },
    "publicReadbackLink": {
      "allOf": [
        { "$ref": "#/$defs/publicLink" },
        { "type": "object", "properties": { "ref": { "type": "string", "pattern": "^docs/" } } }
      ]
    },
    "publicLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planningArtifact", "implementationPrs", "release", "publicReadback"],
      "properties": {
        "planningArtifact": { "$ref": "#/$defs/planningArtifactLink" },
        "implementationPrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/implementationPrLink" }
        },
        "release": {
          "anyOf": [
            { "$ref": "#/$defs/releaseLink" },
            { "type": "null" }
          ]
        },
        "publicReadback": { "$ref": "#/$defs/publicReadbackLink" }
      }
    }
  }
}

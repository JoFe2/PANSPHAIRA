{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psai-modul-manifest.schema.json",
  "title": "PsAI Modul-Manifest (AP-D1)",
  "type": "object",
  "required": ["id", "titel", "version", "datenquellen", "aktionen", "slots", "optionen"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^modul\\.[a-z0-9.-]+$" },
    "titel": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "icon": { "type": "string" },
    "mitlieferTemplate": {
      "type": "array", "items": {
        "type": "object", "required": ["katalogId", "schicht"],
        "properties": { "katalogId": { "type": "string" }, "schicht": { "enum": ["layout", "design", "funktion"] } },
        "additionalProperties": false
      }
    },
    "datenquellen": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["id", "adapter", "zugriff"],
        "properties": {
          "id": { "type": "string" },
          "adapter": { "enum": ["rest", "csv", "mock", "stream"] },
          "zugriff": { "enum": ["nur-lesen", "lesend-schreibend"] },
          "intervallSek": { "type": "integer", "minimum": 5 },
          "readback": { "type": "boolean", "description": "Quittung verifiziert am führenden Speicher" }
        },
        "additionalProperties": false
      }
    },
    "aktionen": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "effekt", "quittung"],
        "properties": {
          "id": { "type": "string" },
     	  "effekt": { "type": "string" },
          "quittung": { "type": "boolean" },
          "undoFensterSek": { "type": "integer", "default": 30 },
          "rollen": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["slot", "minGroesse"],
        "properties": {
          "slot": { "enum": ["nav", "home-kachel", "detail-panel", "overlay-inhalt", "statusleiste", "chronik"] },
          "minGroesse": { "type": "string", "description": "z.B. 240x120" },
          "praefertOverlay": { "type": "boolean", "description": "Vorschlag, Entscheidung bleibt bei Shell (B3)" }
        },
        "additionalProperties": false
      }
    },
    "optionen": {
      "type": "array", "items": {
        "type": "object", "required": ["schluessel", "default", "werte"],
        "properties": {
          "schluessel": { "type": "string" },
          "default": true,
          "werte": { "type": "array", "items": true },
          "rollenfreigabe": { "type": "array", "items": { "type": "string" } },
          "anzeigeort": { "enum": ["panel", "einstellungen", "kontextmenue"] }
        },
        "additionalProperties": false
      }
    },
    "rechte": { "type": "array", "items": { "type": "string" } }
  }
}

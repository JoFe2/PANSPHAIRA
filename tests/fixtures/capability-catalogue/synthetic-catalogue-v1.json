      "actionId": "crm.contact.create",
      "version": "1.0.0",
      "resource": "synthetic.crm.contact",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "name"
        ],
        "properties": {
          "email": {
            "type": "string",

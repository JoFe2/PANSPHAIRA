  "minimumProofRules": {
    "POTENTIAL_EQUIVALENCE": {
      "minimumDistinctTrainingSystems": 2,
      "requiredMatchingDimensions": [
        "purpose"
      ],
      "requiredAdditionalMatchingDimensionsAnyOf": [
        "inputsOutputs",
        "preconditions",
        "invariants",
        "statesTransitions",
        "effects",
        "readbacks"
      ],
      "requireExactCellReferences": true,
      "requireExactFactReferences": true,
      "forbidInvolvedStates": [
        "ABSENT",
        "CONFLICTING"
      ],
      "requireZeroUnresolvedCounterexamples": true
    },
    "VARIANT_RELATION": {
      "minimumDistinctTrainingSystems": 2,
      "requiredMatchingDimensions": [
        "purpose"
      ],
      "requiredDifferingDimensionsAnyOf": [
        "inputsOutputs",
        "preconditions",
        "invariants",
        "statesTransitions",
        "effects",
        "readbacks"
      ],
      "requireExactCellReferences": true,
      "requireExactFactReferences": true
    },
    "DISTINCT": {
      "requiresPositiveMaterialDifferenceAnyOf": [
        "purpose",
        "effects",
        "contract"
      ],
      "absenceOfProofInsufficient": true,
      "requireExactCellReferences": true,
      "requireExactFactReferences": true
    },
    "DENIED": {
      "triggers": [
        "ABSENT",
        "CONFLICTING",
        "FORBIDDEN_SHORTCUT",
        "INVENTED_EVIDENCE"
      ]
    },
    "UNRESOLVED": {
      "trigger": "INSUFFICIENT_EXACT_EVIDENCE_FOR_OTHER_STATE"
    }
  },
